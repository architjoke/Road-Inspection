# Secrets and local environments
.env
**/.env
venv/
.venv/

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime data (logs, uploads, reports, media cache) — keep only the folder skeleton
instance/**
!instance/**/
!instance/**/.gitkeep

# Datasets (multi-GB) — never commit; see docs/data.md
data/

# Model artifacts: only the promoted best.pt + best.model.json are tracked
artifacts/runs/
artifacts/backups/
artifacts/ai_models/best_*.pt
artifacts/ai_models/*.bak*
artifacts/ai_models/*.zip
