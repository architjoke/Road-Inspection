# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# AWS RDS PostgreSQL (same credentials as DBeaver)
# URL-encode special characters in the password (@, #, /, etc.)
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@YOUR-RDS-HOST:5432/postgres?sslmode=require

# Optional Phase 3 lockout
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_LOCKOUT_MINUTES=15

# Optional seed (scripts/seed_auth.py) — never commit real passwords
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_FULL_NAME=Test Administrator
# SEED_ADMIN_PASSWORD=change-me
# SEED_MUNICIPALITY_ID=1

# Phase 5 storage (future)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
