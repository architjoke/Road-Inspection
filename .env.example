# Copy to .env and fill in real values. Never commit .env.
# Settings marked "DB" can also be edited in the system_settings table; an
# uncommented value here wins over the database.

# --- Server -------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Runtime data (logs, uploads, reports, media cache). Default: ./instance
# INSTANCE_DIR=
LOG_LEVEL=INFO

# --- Database (Supabase Postgres + PostGIS) ----------------------------------
# false = use DATABASE_URL; true = offline demo store (no remote DB)
OFFLINE_MODE=false
# Session pooler URL. URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg2://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth ----------------------------------------------------------------------
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_LOCKOUT_MINUTES=15
# SESSION_COOKIE_SECURE=true   # enable behind HTTPS
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@municipality.local
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_PASSWORD
SEED_MUNICIPALITY_ID=1

# --- Media storage (ImageKit) -------------------------------------------------
IMAGEKIT_PUBLIC_KEY=public_YOUR_IMAGEKIT_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_YOUR_IMAGEKIT_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# --- Detection model (YOLO) ---------------------------------------------------
# YOLO_MODEL_PATH=artifacts/ai_models/best.pt
# Fallback threshold; per-class thresholds come from best.model.json when present.
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
# auto = the size the promoted model was trained at (best.model.json), else 640
YOLO_IMGSZ=auto
YOLO_DEVICE=cpu
YOLO_FORCE_MOCK=false
# YOLO_CLASS_THRESHOLDS=off   # ignore per-class thresholds from the model card
ANALYSIS_MAX_WORKERS=2

# --- Optional segmentation / depth (off until weights exist) -----------------
SEGMENTATION_ENABLED=false
SEGMENTATION_FORCE_MOCK=true
# SEGMENTATION_MODEL_PATH=artifacts/ai_models/crack_seg.pt
SEGMENTATION_DEVICE=cpu
SEGMENTATION_CONFIDENCE_THRESHOLD=0.25
SEGMENTATION_IMAGE_SIZE=640
DEPTH_ENABLED=false
DEPTH_FORCE_MOCK=true
# DEPTH_MODEL_PATH=artifacts/ai_models/depth_model.pt
DEPTH_MODEL_TYPE=relative_mock
DEPTH_DEVICE=cpu
DEPTH_IMAGE_SIZE=384
DEPTH_NORMALIZATION_MODE=relative
DEPTH_MIN_CONFIDENCE=0.0

# --- Severity (v2: graded on estimated physical size) -------------------------
# Pothole diameter/depth thresholds: DB system_settings.severity_thresholds.
# Confidence only decides manual review, never the severity level.
SEVERITY_RULE_VERSION=phase10-v2-geometry
SEVERITY_CONFIDENCE_MIN_REVIEW=0.35
SEVERITY_CONFIDENCE_AMBIGUOUS=0.45
# Assumed camera pose for photo -> metres (handheld phone; video = vehicle-mounted)
CAMERA_HEIGHT_M=1.4
CAMERA_PITCH_DEG=30
CAMERA_HFOV_DEG=66
CAMERA_MAX_RANGE_M=20
CAMERA_VIDEO_HEIGHT_M=1.3
CAMERA_VIDEO_PITCH_DEG=12

# --- Repair cost --------------------------------------------------------------
# Unit rates: DB system_settings.setting_key = 'repair_cost_rates' (JSON).
# Keys and placeholder defaults: app/ai/cost_engine.py DEFAULT_COST_RATES.

# --- GPS -----------------------------------------------------------------------
# Browser fixes coarser than REVIEW are flagged; coarser than REJECT are refused
# (the user pins the location on the map instead).
GPS_REVIEW_ACCURACY_M=100
GPS_REJECT_ACCURACY_M=5000

# --- Before/after verification -------------------------------------------------
# DB: ssim_repair_verified_threshold / ssim_manual_review_threshold. Uncomment to override.
# VERIFICATION_SSIM_VERIFIED_MAX=0.60
# VERIFICATION_SSIM_PARTIAL_MAX=0.85

# --- Rate limiting / security -------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=2000 per hour;200 per minute
SECURITY_HEADERS_ENABLED=true
