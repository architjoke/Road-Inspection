# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# AWS RDS PostgreSQL (same credentials as DBeaver)
# URL-encode special characters in the password (@, #, /, etc.)
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@YOUR-RDS-HOST:5432/postgres?sslmode=require

# Phase 5 storage (future)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
