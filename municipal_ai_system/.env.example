# Flask
# Copy this file to municipal_ai_system/.env and fill in real values.
# Never commit .env
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---------------------------------------------------------------------------
# Mode: login uses RDS only when OFFLINE_MODE is false (or omitted) AND
# DATABASE_URL is a real host (not YOUR-RDS-HOST).
# Campus Wi-Fi demo without RDS: OFFLINE_MODE=true
# ---------------------------------------------------------------------------
OFFLINE_MODE=false

# ---------------------------------------------------------------------------
# PostgreSQL (required for login and all DB features)
# 1) Copy this file to municipal_ai_system/.env  (do not commit .env)
# 2) Replace DATABASE_URL with your real RDS / Postgres connection
# 3) URL-encode special characters in the password (@ → %40, # → %23, etc.)
# 4) Restart the Flask app after saving .env
# 5) File must be UTF-8 (Notepad: Save as UTF-8, not Unicode/UTF-16)
#
# Format:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@YOUR-RDS-HOST:5432/postgres?sslmode=require

# Optional Phase 3 lockout
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_LOCKOUT_MINUTES=15

# Optional seed (scripts/seed_auth.py)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@municipality.local
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_PASSWORD
SEED_MUNICIPALITY_ID=1

# ---------------------------------------------------------------------------
# Phase 5 — ImageKit CDN storage (required for cloud media URLs)
# Get keys from https://imagekit.io/dashboard/developer/api-keys
# ---------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=public_YOUR_IMAGEKIT_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_YOUR_IMAGEKIT_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# ---------------------------------------------------------------------------
# Phase 6/7 — YOLO analysis (CPU by default; no RDS required for mock/tests)
# ---------------------------------------------------------------------------
# YOLO_MODEL_PATH=app/ai_models/best.pt
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=640
YOLO_DEVICE=cpu
YOLO_FORCE_MOCK=false
ANALYSIS_MAX_WORKERS=2

# ---------------------------------------------------------------------------
# Phase 8 — optional segmentation (disabled by default; mock-first)
# best.pt is detection-only and cannot be used as SEGMENTATION_MODEL_PATH.
# ---------------------------------------------------------------------------
SEGMENTATION_ENABLED=false
SEGMENTATION_FORCE_MOCK=true
# SEGMENTATION_MODEL_PATH=app/ai_models/yolo_seg.pt
SEGMENTATION_DEVICE=cpu
SEGMENTATION_CONFIDENCE_THRESHOLD=0.25
SEGMENTATION_IMAGE_SIZE=640

# ---------------------------------------------------------------------------
# Phase 9 — optional monocular depth (relative only; no auto-download)
# ---------------------------------------------------------------------------
DEPTH_ENABLED=false
DEPTH_FORCE_MOCK=true
# DEPTH_MODEL_PATH=app/ai_models/depth_model.pt
DEPTH_MODEL_TYPE=relative_mock
DEPTH_DEVICE=cpu
DEPTH_IMAGE_SIZE=384
DEPTH_NORMALIZATION_MODE=relative
DEPTH_MIN_CONFIDENCE=0.0

# ---------------------------------------------------------------------------
# Phase 10 — damage severity engine
# ---------------------------------------------------------------------------
SEVERITY_RULE_VERSION=phase10-v1
SEVERITY_CONFIDENCE_MIN_REVIEW=0.35
SEVERITY_CONFIDENCE_AMBIGUOUS=0.45
SEVERITY_SCORE_SEVERE=0.72
SEVERITY_SCORE_MODERATE=0.42

# ---------------------------------------------------------------------------
# Phase 12 — before/after OpenCV SSIM verification
# ---------------------------------------------------------------------------
VERIFICATION_SSIM_VERIFIED_MAX=0.60
VERIFICATION_SSIM_PARTIAL_MAX=0.85

# ---------------------------------------------------------------------------
# Phase 13 — report exporter
# ---------------------------------------------------------------------------
# REPORTS_OUTPUT_ROOT=app/instance/generated_reports

# ---------------------------------------------------------------------------
# Phase 14 — security / logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=100 per hour;20 per minute
RATELIMIT_API_SENSITIVE=30 per minute;200 per hour
SECURITY_HEADERS_ENABLED=true
# SESSION_COOKIE_SECURE=true
